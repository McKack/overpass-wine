EXTRADEFS = -D_WINHTTP_INTERNAL_
EXTRAINCL = -I$(srcdir)/../libnghttp2/includes $(ZLIB_PE_CFLAGS)
MODULE    = winhttp.dll
IMPORTLIB = winhttp
IMPORTS   = $(ZLIB_PE_LIBS) uuid jsproxy user32 advapi32 ws2_32
DELAYIMPORTS = oleaut32 crypt32 secur32 iphlpapi dhcpcsvc

SOURCES = \
	cookie.c \
	handle.c \
	http2.c \
	main.c \
	net.c \
	request.c \
	rsrc.rc \
	session.c \
	url.c \
	winhttp_tlb.idl
